# --- Database / cache ---
DATABASE_URL=postgresql://user:password@localhost:5432/the_r_profit_management
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth (Microsoft Entra ID / Azure AD SSO) ---
# Phase 1: single-tenant app registration restricted to elev8-suite.com.
# See docs/entra-sso-setup.md for the exact Azure Portal steps.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# DEV ONLY — bypasses Microsoft SSO with an unverified email/name form so you
# can develop/test before the real Entra ID app registration is done. Leave
# unset in any environment anyone outside the current single tenant can
# reach. See the big warning in apps/web/src/auth.ts.
ENABLE_DEV_LOGIN=false

# --- External integrations ---
# Confirmed 2026-08-07, live: PriceLabs Customer API (X-API-Key header). Real
# client at packages/integrations/src/pricelabs/client.ts. $1/month per synced
# listing, billed by PriceLabs. Set as a Railway env var — never commit the
# real value.
PRICELABS_API_KEY=
# MyDataValue DOES have a real REST API (confirmed 2026-08-07 via the MDV MCP
# connector's documented /api/v1/... paths) — unlike Elev8, this is not a dead
# end. Not yet confirmed: the exact base URL/auth this app should use, or
# whether write endpoints (pushing promotion/discount changes) exist at all —
# every MDV MCP tool available today is read-only. Ask MyDataValue
# support/account settings for a customer API key + their API docs before
# wiring packages/integrations/src/mdv/client.ts up for real.
MDV_API_KEY=
# Confirmed 2026-08-06: "The R" = MDV account_name "Reto Wyss" only. Other
# account_names on the connected MDV account belong to unrelated sub-accounts.
MDV_ALLOWED_ACCOUNT_NAMES=Reto Wyss
ELEV8_API_KEY=
# Confirmed 2026-08-07 via partnerapiintegration.md + Postman collection: Elev8 Suite's
# "Partner API" (todos/listings/users/roles only — NOT revenue/occupancy/reviews, see
# packages/integrations/src/elev8/client.ts for the scope limit).
ELEV8_API_BASE_URL=https://api.elev8-suite.com

# --- FX normalization (Profit PAR across IDR/CHF/USD listings) ---
# No live FX API is wired up yet — packages/db/prisma/seedData/fxRatesSeed.ts has a
# one-time manual placeholder. Reporting currency is CHF.
FX_API_KEY=

# --- AI-generated suggestions (per-listing goal + data -> Claude recommendation) ---
# A real Anthropic API key from console.anthropic.com — a separate credential
# from anything else in this project. Used by apps/web/src/app/listings/actions.ts
# (generateAiSuggestion) to turn a listing's free-text goalNotes + its latest
# real signals into one AI_SUGGESTION recommendation on demand. Set as a
# Railway env var on web-app — never commit the real value.
ANTHROPIC_API_KEY=
