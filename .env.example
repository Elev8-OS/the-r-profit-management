# --- Database / cache ---
DATABASE_URL=postgresql://user:password@localhost:5432/the_r_profit_management
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth (Microsoft Entra ID / Azure AD SSO) ---
# Phase 1: single-tenant app registration restricted to elev8-suite.com.
# See docs/entra-sso-setup.md for the exact Azure Portal steps.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# DEV ONLY — bypasses Microsoft SSO with an unverified email/name form so you
# can develop/test before the real Entra ID app registration is done. Leave
# unset in any environment anyone outside the current single tenant can
# reach. See the big warning in apps/web/src/auth.ts.
ENABLE_DEV_LOGIN=false

# --- External integrations ---
# Confirmed 2026-08-07, live: PriceLabs Customer API (X-API-Key header). Real
# client at packages/integrations/src/pricelabs/client.ts. $1/month per synced
# listing, billed by PriceLabs. Set as a Railway env var — never commit the
# real value.
PRICELABS_API_KEY=
# MyDataValue write access CONFIRMED 2026-08-07 — MDV support granted this
# account a genuine OAuth2 customer credential (separate from the read-only
# MDV MCP connector used during planning). Auth is client_id/client_secret +
# a rotating refresh_token, NOT a static API key: every exchange at
# https://app.mydatavalue.com/oauth/token returns a new access_token AND a
# new refresh_token, and immediately invalidates the old refresh_token —
# reusing an old one shuts down access entirely (needs MDV support to
# re-issue). Because of that rotation, only the ONE-TIME initial
# refresh_token goes in an env var; the live, constantly-rotating value is
# persisted in the MdvOAuthCredential table instead (see
# packages/db/src/mdvTokenStore.ts + packages/integrations/src/mdv/tokenManager.ts).
# Set these three as Railway env vars — never commit real values:
MDV_CLIENT_ID=
MDV_CLIENT_SECRET=
MDV_INITIAL_REFRESH_TOKEN=
# Endpoint shapes CONFIRMED 2026-08-07 from MDV's real OpenAPI spec (Reto
# uploaded api1.yaml — MDV's docs page itself is blocked for automated fetch
# by robots.txt). Real implementation in packages/integrations/src/mdv/client.ts.
# Important correction vs the earlier assumption here: there is NO endpoint
# to directly set a promotion/discount or a specific price — /booking/promotions/
# and /airbnb/promotions/ are read-only. The only real write levers are
# turning MDV's own nightly auto-push on/off per property/listing
# (PUT .../auto-refresh/) and setting a Booking.com-only "Guest Target %"
# (PUT /booking/guest-target/) — see that file's header comment for detail.
# Confirmed 2026-08-06: "The R" = MDV account_name "Reto Wyss" only. Other
# account_names on the connected MDV account belong to unrelated sub-accounts.
MDV_ALLOWED_ACCOUNT_NAMES=Reto Wyss
ELEV8_API_KEY=
# Confirmed 2026-08-07 via partnerapiintegration.md + Postman collection: Elev8 Suite's
# "Partner API" (todos/listings/users/roles only — NOT revenue/occupancy/reviews, see
# packages/integrations/src/elev8/client.ts for the scope limit).
ELEV8_API_BASE_URL=https://api.elev8-suite.com

# --- FX normalization (Profit PAR across IDR/CHF/USD listings) ---
# No live FX API is wired up yet — packages/db/prisma/seedData/fxRatesSeed.ts has a
# one-time manual placeholder. Reporting currency is CHF.
FX_API_KEY=

# --- AI-generated suggestions (per-listing goal + data -> Claude recommendation) ---
# A real Anthropic API key from console.anthropic.com — a separate credential
# from anything else in this project. Used by apps/web/src/app/listings/actions.ts
# (generateAiSuggestion) to turn a listing's free-text goalNotes + its latest
# real signals into one AI_SUGGESTION recommendation on demand, following the
# "Senior Revenue Manager" persona Reto provided 2026-08-07 (saved to the
# project as architecture/ai-suggestion-revenue-manager-persona.md). Set as a
# Railway env var on web-app — never commit the real value.
#
# Cost note: this call has Claude's server-side web search tool enabled (up to
# 3 searches per click, per the persona's external-research methodology) —
# each search has its own cost on top of normal token usage, separate from
# the flat per-token pricing everything else in this app uses.
ANTHROPIC_API_KEY=
