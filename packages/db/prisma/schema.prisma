// The R — Profit & Revenue Management
// Prisma schema v1 — see /docs plan for rationale.
// Multi-tenant from day 1: every tenant-scoped model carries tenantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & Auth ----------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users            User[]
  listings         InternalListing[]
  costRateCards    CostRateCard[]
  recommendations  Recommendation[]
  syncRuns         SyncRun[]
  portfolioContext PortfolioContextSnapshot?
  mdvOAuthCredential MdvOAuthCredential?
}

model User {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  email          String   @unique
  displayName    String?
  entraObjectId  String?  @unique
  entraTenantId  String?
  role           UserRole @default(ADMIN)
  createdAt      DateTime @default(now())

  decidedRecommendations Recommendation[]      @relation("DecidedBy")
  auditLogEntries        RecommendationAuditLog[]
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

// ---------- Listings & cross-system ID mapping ----------

model InternalListing {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  displayName    String
  brand          String?
  country        String?
  city           String?
  currency       String?
  capacity       Int?
  status         String   @default("active")
  // Free-text owner intent for this unit (e.g. "maximize occupancy in Q4",
  // "protect margin, don't chase last-minute discounts") — fed into the
  // AI_SUGGESTION generator alongside real signal data. Plain text, not
  // structured; the generator does the interpretation.
  goalNotes      String?   @db.Text
  goalUpdatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  externalRefs      ListingExternalRef[]
  reservations      Reservation[]
  dailyMetrics      DailyMetric[]
  fixedCosts        CostFixedMonthly[]
  cleaningCosts     CostCleaning[]
  capexCosts        CostCapex[]
  kpiSnapshots      KpiDailySnapshot[]
  recommendations   Recommendation[]
  rateCardOverride  CostRateCard[]
  channelFunnels    ListingChannelFunnel[]
  reviewScores      ListingReviewScore[]
  priceLabsHealth   PriceLabsHealthSnapshot[]
  priceLabsNudges   PriceLabsNudge[]
  opportunityScores OpportunityScoreSnapshot[]

  @@index([tenantId])
}

enum ExternalSystem {
  PRICELABS
  MDV_AIRBNB
  MDV_BOOKING
  ELEV8
}

model ListingExternalRef {
  id                String          @id @default(cuid())
  internalListingId String
  internalListing   InternalListing @relation(fields: [internalListingId], references: [id])
  system            ExternalSystem
  externalId        String
  externalMeta      Json?
  matchConfidence   String          @default("unmatched") // confirmed | heuristic | unmatched
  createdAt         DateTime        @default(now())

  @@unique([system, externalId])
  @@index([internalListingId])
}

// ---------- Revenue facts ----------

model Reservation {
  id                  String          @id @default(cuid())
  internalListingId   String
  internalListing     InternalListing @relation(fields: [internalListingId], references: [id])
  sourceSystem        ExternalSystem
  externalReservationId String
  channel             String?
  checkIn             DateTime
  checkOut            DateTime
  grossRevenue        Decimal         @db.Decimal(12, 2)
  currency            String
  status              String
  createdAt           DateTime        @default(now())

  @@unique([sourceSystem, externalReservationId])
  @@index([internalListingId])
}

model DailyMetric {
  id                String          @id @default(cuid())
  internalListingId String
  internalListing   InternalListing @relation(fields: [internalListingId], references: [id])
  date              DateTime        @db.Date
  revenue           Decimal         @db.Decimal(12, 2) @default(0)
  adr               Decimal?        @db.Decimal(12, 2)
  isAvailable       Boolean         @default(true)
  isOccupied        Boolean         @default(false)

  @@unique([internalListingId, date])
  @@index([internalListingId])
}

// ---------- Costs ----------

model CostFixedMonthly {
  id                String          @id @default(cuid())
  internalListingId String
  internalListing   InternalListing @relation(fields: [internalListingId], references: [id])
  category          String // rent | mortgage | utilities | insurance | software | other
  amount            Decimal         @db.Decimal(12, 2)
  currency          String
  effectiveStart    DateTime        @db.Date
  effectiveEnd      DateTime?       @db.Date
  notes             String?
  createdAt         DateTime        @default(now())

  @@index([internalListingId])
}

model CostRateCard {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  internalListingId  String?          // null = tenant-wide default
  internalListing    InternalListing? @relation(fields: [internalListingId], references: [id])
  type               String // cleaning_hourly | cleaning_flat | management_fee_pct
  value              Decimal          @db.Decimal(12, 4)
  effectiveStart     DateTime         @db.Date
  effectiveEnd       DateTime?        @db.Date

  @@index([tenantId])
  @@index([internalListingId])
}

model CostCleaning {
  id                String          @id @default(cuid())
  internalListingId String
  internalListing   InternalListing @relation(fields: [internalListingId], references: [id])
  date              DateTime        @db.Date
  reservationId     String?
  costAmount        Decimal         @db.Decimal(12, 2)
  durationMinutes   Int?
  source            String // elev8_auto | manual
  createdAt         DateTime        @default(now())

  @@index([internalListingId])
}

model CostCapex {
  id                String          @id @default(cuid())
  internalListingId String
  internalListing   InternalListing @relation(fields: [internalListingId], references: [id])
  date              DateTime        @db.Date
  category          String // repair | damage | furniture | other
  amount            Decimal         @db.Decimal(12, 2)
  description       String?
  createdAt         DateTime        @default(now())

  @@index([internalListingId])
}

// ---------- KPIs ----------

model KpiDailySnapshot {
  id                     String          @id @default(cuid())
  internalListingId      String
  internalListing        InternalListing @relation(fields: [internalListingId], references: [id])
  date                   DateTime        @db.Date
  revenue                Decimal         @db.Decimal(12, 2)
  fixedCostAllocated     Decimal         @db.Decimal(12, 2)
  cleaningCost           Decimal         @db.Decimal(12, 2)
  managementFee          Decimal         @db.Decimal(12, 2)
  capexAllocated         Decimal         @db.Decimal(12, 2)
  revpar                 Decimal         @db.Decimal(12, 2)
  operatingProfitPar     Decimal         @db.Decimal(12, 2)
  fullyLoadedProfitPar   Decimal         @db.Decimal(12, 2)
  formulaVersion         String          @default("v1")
  createdAt              DateTime        @default(now())

  @@unique([internalListingId, date, formulaVersion])
  @@index([internalListingId])
}

// ---------- Recommendations ----------

enum RecommendationType {
  PRICE_OVERRIDE
  ACCEPT_NUDGE
  REJECT_NUDGE
  MIN_STAY_CHANGE
  MDV_DISCOUNT_CHANGE
  SYSTEM_CONFLICT
  // Free-text, non-pushable suggestion generated from a listing's goalNotes
  // + its latest real signal data (PriceLabs health, nudges, opportunity
  // drivers). Informational only — approve/reject like any other
  // recommendation, but there is no structured external action to push.
  AI_SUGGESTION
}

enum RecommendationStatus {
  PENDING
  APPROVED
  SENT
  REJECTED
  EXPIRED
  FAILED
}

model Recommendation {
  id                String                @id @default(cuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  internalListingId String
  internalListing   InternalListing       @relation(fields: [internalListingId], references: [id])
  type              RecommendationType
  dateRangeStart    DateTime?             @db.Date
  dateRangeEnd      DateTime?             @db.Date
  triggerSignal     Json
  proposedAction    Json
  rationaleText     String
  status            RecommendationStatus  @default(PENDING)
  targetSystem      ExternalSystem?
  externalActionRef String?
  decidedById       String?
  decidedBy         User?                 @relation("DecidedBy", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  createdAt         DateTime              @default(now())

  auditLog          RecommendationAuditLog[]

  @@index([tenantId])
  @@index([internalListingId])
}

model RecommendationAuditLog {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id])
  action           String // created | viewed | approved | rejected | sent | send_failed
  actorUserId      String?
  actorUser        User?          @relation(fields: [actorUserId], references: [id])
  payloadSnapshot  Json?
  createdAt        DateTime       @default(now())

  @@index([recommendationId])
}

// ---------- Sync bookkeeping ----------

model SyncRun {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  system          ExternalSystem
  jobName         String
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
  status          String        @default("running") // running | success | failed
  recordsFetched  Int?
  recordsUpserted Int?
  errorMessage    String?
  triggeredBy     String? // "schedule" | userId

  @@index([tenantId])
}

// ---------- Opportunity Score — "what needs attention" ----------
// FX rates, channel-funnel/review signals from MyDataValue, PriceLabs market-health
// snapshots and pricing nudges, and the resulting per-listing Opportunity Score.
// See packages/shared/src/kpi/computeOpportunityScore.ts for the scoring formula and
// packages/db/prisma/seedOpportunitySignals.ts for how these get populated from the
// one-time manual data captures in prisma/seedData/*.

model FxRate {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  currency   String   // "CHF" | "USD" | "EUR" | "IDR" ...
  chfPerUnit Decimal  @db.Decimal(18, 8) // 1 unit of `currency` = chfPerUnit CHF. Reporting currency is CHF.
  source     String   // e.g. "manual-seed-2026-08-07" now; a real FX API job later
  createdAt  DateTime @default(now())

  @@unique([date, currency])
}

model ListingChannelFunnel {
  id                 String          @id @default(cuid())
  internalListingId  String
  internalListing    InternalListing @relation(fields: [internalListingId], references: [id])
  system             ExternalSystem  // MDV_BOOKING | MDV_AIRBNB
  periodEnd          DateTime        @db.Date // "data as of" date for this snapshot
  searchViews        Int
  propertyViews      Int
  bookingConversions Int
  searchToViewRate   Decimal?        @db.Decimal(10, 6)
  viewToBookingRate  Decimal?        @db.Decimal(10, 6)
  createdAt          DateTime        @default(now())

  @@unique([internalListingId, system, periodEnd])
  @@index([internalListingId])
}

model ListingReviewScore {
  id                 String          @id @default(cuid())
  internalListingId  String
  internalListing    InternalListing @relation(fields: [internalListingId], references: [id])
  system             ExternalSystem  // MDV_BOOKING | MDV_AIRBNB
  reviewScore10      Decimal         @db.Decimal(4, 2) // normalized to a 0-10 scale (Airbnb's 0-5 * 2)
  reviewScoreRaw     Decimal         @db.Decimal(4, 2) // as returned by the source
  reviewCount        Int
  asOf               DateTime        @db.Date
  createdAt          DateTime        @default(now())

  @@unique([internalListingId, system, asOf])
  @@index([internalListingId])
}

model PriceLabsHealthSnapshot {
  id                     String          @id @default(cuid())
  internalListingId      String
  internalListing        InternalListing @relation(fields: [internalListingId], references: [id])
  statusColor            String          // Red | Yellow | Green | Blue
  statusText             String
  marketSection          Json
  recommendationSection  Json
  analyzedAt             DateTime
  createdAt              DateTime        @default(now())

  @@index([internalListingId])
}

model PriceLabsNudge {
  id                 String          @id @default(cuid())
  internalListingId  String
  internalListing    InternalListing @relation(fields: [internalListingId], references: [id])
  nudgeId            String          @unique
  nudgeType          String
  currentValue       Decimal         @db.Decimal(12, 2)
  suggestedValue     Decimal         @db.Decimal(12, 2)
  direction          String
  reason             String
  expiration         DateTime
  status             String          @default("pending") // pending | accepted | dismissed | expired
  createdAt          DateTime        @default(now())

  @@index([internalListingId])
}

// Tenant-wide (NOT per-listing) channel-mix + guest-origin snapshot, pulled
// one-time from Elev8's own MCP tools (get_revenue_by_channel, get_guest_origins)
// via an interactive session — Elev8's confirmed Partner API (the only one the
// deployed app can reach) has no revenue/channel/guest-origin endpoints, so
// this can't be a live per-request job yet. Feeds the AI_SUGGESTION generator's
// "dynamische Bestandsaufnahme" step (persona doc, architecture/ai-suggestion-
// revenue-manager-persona.md) with real but portfolio-level, point-in-time data.
// One row per tenant — re-running the seed script overwrites it with a fresher
// capture rather than accumulating history.
model PortfolioContextSnapshot {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  channelMix   Json     // { periodLabel, capturedAt, rows: [{channel, pctOfRevenue, pctOfBookings, ...}] }
  guestOrigins Json     // { periodLabel, capturedAt, topRows: [...], longTailNote }
  source       String
  capturedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OpportunityScoreSnapshot {
  id                          String          @id @default(cuid())
  internalListingId           String
  internalListing             InternalListing @relation(fields: [internalListingId], references: [id])
  date                        DateTime        @db.Date
  score                       Int             // 0-100, higher = more urgent
  estimatedMonthlyLeakageChf  Decimal?        @db.Decimal(12, 2)
  drivers                     Json            // array of {category, severity (0-100), detail, actionSuggestion}
  formulaVersion              String          @default("v1")
  createdAt                   DateTime        @default(now())

  @@unique([internalListingId, date, formulaVersion])
  @@index([date])
}

// ---------- MyDataValue OAuth2 write access ----------
// Confirmed 2026-08-07: MyDataValue granted write access via a genuine
// customer OAuth2 credential (client_id/client_secret + refresh_token),
// separate from the read-only MDV MCP connector used during planning. Per
// MDV support's explicit instructions, EVERY token exchange returns a new
// access_token AND a new refresh_token, immediately invalidating the old
// refresh_token — reusing an old one is treated as a stolen-token event and
// shuts down access entirely (recoverable only via MDV support re-issuance).
// A static env var can't hold a value that rotates on every use, so the
// current refresh_token (plus a cached access_token) lives here instead,
// one row per tenant. `version` is an optimistic-concurrency guard so two
// processes (apps/web and apps/worker) can't both refresh the same
// refresh_token at once and invalidate each other — see
// packages/integrations/src/mdv/tokenManager.ts (MdvTokenManager) and
// packages/db/src/mdvTokenStore.ts (PrismaMdvTokenStore) for the claim/CAS
// logic that uses this field. Never seed/update this table's refreshToken
// or accessToken columns with anything other than what MDV's token endpoint
// itself returns — no guessing, no hardcoding besides the one-time initial
// refresh_token from MDV support (kept in the MDV_INITIAL_REFRESH_TOKEN env
// var, used only to bootstrap the very first row for a tenant).
model MdvOAuthCredential {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  refreshToken         String    @db.Text
  accessToken          String?   @db.Text
  accessTokenExpiresAt DateTime?
  version              Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
